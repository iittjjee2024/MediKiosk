# MediKiosk backend configuration.
#
# Copy this file to `.env` and adjust. All variables are prefixed MEDIKIOSK_
# and are read by app/config.py (pydantic-settings) or app/main.py.
# The `.env` file is git-ignored; this `.env.example` is committed as the
# reference. Never commit real secrets.

# --- environment ------------------------------------------------------------
MEDIKIOSK_ENVIRONMENT=development

# --- database ---------------------------------------------------------------
# SQLite needs no server and is fine for the demo and tests:
MEDIKIOSK_DATABASE_URL=sqlite+pysqlite:///./medikiosk_demo.db
# PostgreSQL (docker-compose default) instead:
# MEDIKIOSK_DATABASE_URL=postgresql+psycopg://medikiosk:medikiosk@localhost:5432/medikiosk

# --- authentication ---------------------------------------------------------
# CHANGE THIS in any non-local environment. Tokens are signed with it.
MEDIKIOSK_JWT_SECRET=dev-only-change-me
MEDIKIOSK_JWT_ALGORITHM=HS256
MEDIKIOSK_PATIENT_TOKEN_MINUTES=20
MEDIKIOSK_STAFF_TOKEN_MINUTES=30

# --- confidence gate thresholds (see app/engines/confidence.py) -------------
# Speech is admitted at >= conf_high, marked-unconfirmed at >= conf_medium,
# and withheld (sent to a human) below conf_medium. Documents are held to a
# stricter bar because a misread drug name is worse than a misheard symptom.
MEDIKIOSK_CONF_HIGH=0.85
MEDIKIOSK_CONF_MEDIUM=0.60
MEDIKIOSK_CONF_HIGH_DOCUMENT=0.90
MEDIKIOSK_CONF_MEDIUM_DOCUMENT=0.70
MEDIKIOSK_CONF_UNREADABLE_DOCUMENT=0.35

# --- red-flag SLA -----------------------------------------------------------
MEDIKIOSK_DEFAULT_RED_FLAG_SLA_SECONDS=300

# --- demo data --------------------------------------------------------------
# Set to 1 to populate four realistic sample sessions on first startup so the
# physician / triage / analytics screens are alive immediately.
MEDIKIOSK_SEED_DEMO=1
