# MediKiosk frontend configuration.
#
# Copy to `.env` (or `.env.local`) for local development. Read by
# next.config.ts, which proxies every /api/* request to this backend URL.
# The `.env` file is git-ignored; this `.env.example` is committed.

# Backend base URL the Next.js dev/prod server proxies /api/* to.
MEDIKIOSK_API=http://127.0.0.1:8000

# Disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
